# データベース接続
DATABASE_URL="postgresql://myapp:myapp_password@localhost:5432/myapp_dev"

# --- 解約締切リマインダーメール設定 ---
# 送信元のメールアカウント。デフォルトではGmailを使う(SMTP_HOSTを指定した場合はそちらを優先)。
# Gmailの場合、通常のパスワードではなく「アプリパスワード」を発行して使う。
# https://myaccount.google.com/apppasswords
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-digit-app-password

# 任意: Gmail以外のSMTPサービス(Resendなど)を使う場合に設定する
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587

# 通知メールの送信先
NOTIFY_TO_EMAIL=your-address@gmail.com

# 解約締切の何日前から通知対象にするか（デフォルト: 3）
REMINDER_DAYS_BEFORE=3

# 毎日何時に自動チェックするか（cron形式、デフォルト: 毎日9:00）
REMINDER_CRON="0 9 * * *"
REMINDER_TZ=Asia/Tokyo
